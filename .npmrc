# ─────────────────────────────────────────────────────────────────────────────
# pnpm supply-chain hardening (pnpm 10.x) — https://pnpm.io/supply-chain-security
# Resolution-affecting settings live here so they apply to every install.
# ─────────────────────────────────────────────────────────────────────────────

# Quarantine newly published versions: refuse to resolve a package version that
# is younger than 1440 minutes (24h). This buys time for a compromised release to
# be detected and yanked before it reaches this project. `--frozen-lockfile`
# installs (CI) are unaffected because they never re-resolve.
minimum-release-age=1440

# Re-verify the integrity hash of every package in the content-addressable store
# before linking it into node_modules (defends against a tampered store/cache).
verify-store-integrity=true

# Make `pnpm audit` exit non-zero on moderate-or-higher advisories.
audit-level=moderate

# Pin the registry and require HTTPS.
registry=https://registry.npmjs.org/
